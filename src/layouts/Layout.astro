---
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
import "../css/main.css";
const { title = "Fashion" } = Astro.props;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <Menu />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>